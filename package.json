{
  "name": "qvaapply",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.26.0",
  "type": "module",
  "engines": {
    "node": ">=24 <26"
  },
  "scripts": {
    "build": "pnpm typecheck && pnpm build:server && pnpm build:web",
    "build:server": "tsc -p tsconfig.build.json",
    "build:web": "vite build",
    "dev": "tsx watch src/index.ts",
    "dev:web": "vite build --watch",
    "dev:all": "pnpm dev & pnpm dev:web & wait",
    "preview:ui": "pnpm build:server && pnpm build:web && node scripts/preview-dashboard.mjs",
    "login": "tsx src/login.ts",
    "start": "node --enable-source-maps dist/index.js",
    "test": "tsx --test test/*.test.ts",
    "test:watch": "tsx --test --watch test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm knip && pnpm test && pnpm build:server && pnpm build:web && pnpm check:secrets",
    "check:ui": "pnpm build && node scripts/visual-smoke.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "knip": "knip"
  },
  "dependencies": {
    "@nats-io/jetstream": "^3.4.0",
    "@nats-io/transport-node": "^3.4.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "dotenv": "^17.2.2",
    "fastify": "^5.12.3",
    "grammy": "^1.38.2",
    "lucide-react": "^0.544.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.0.2",
    "axe-core": "^4.13.0",
    "knip": "^6.35.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vite": "^7.1.4"
  }
}
