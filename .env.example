TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
LOCAL_ENCRYPTION_KEY=

# Mínimo 14 caracteres. Protege el panel aunque hoy solo escuche en localhost.
DASHBOARD_ADMIN_PASSWORD=
DASHBOARD_PORT=3000
DASHBOARD_HOST=127.0.0.1
DASHBOARD_TRUSTED_ORIGIN=http://127.0.0.1:3000
DASHBOARD_SECURE_COOKIES=false
SYNC_ENABLED=false
SYNC_BASE_URL=http://127.0.0.1:8080
SYNC_NATS_URL=nats://127.0.0.1:4222
SYNC_EMAIL=
SYNC_PASSWORD=

# El modo real también debe activarse deliberadamente desde el panel.
CONFIRM_REAL_TRADING=false
DATA_DIR=data

# Opcional: cuenta de servicio dedicada con rol Firebase Cloud Messaging API Admin.
# Guardar el JSON fuera de Git y del APK; ruta dentro del contenedor, archivo 0400 para uid 1000.
QVAAPPLY_FCM_CREDENTIALS_FILE=
