# Runtime mínimo: recibe binarios estáticos ya compilados para linux/amd64.
# El contexto de build es la raíz del repositorio.
FROM scratch

COPY services/trading-core/trading-core /trading-core
COPY services/trading-core/shadow-replay /shadow-replay

EXPOSE 8090

USER 65532:65532

ENTRYPOINT ["/trading-core"]
